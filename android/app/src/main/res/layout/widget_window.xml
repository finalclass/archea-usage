<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/window_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#d5dee6" android:textSize="11sp"/>
        <TextView android:id="@+id/window_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:textColor="#8ed3ff" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
    <ImageView android:id="@+id/meter" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:adjustViewBounds="false" android:contentDescription="@null"/>
</LinearLayout>
