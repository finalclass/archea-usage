<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/window_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#8fa1b3" android:textSize="12sp"/>
        <TextView android:id="@+id/window_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8ed3ff" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>
    <ImageView android:id="@+id/meter" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="5dp" android:scaleType="fitXY" android:adjustViewBounds="false" android:contentDescription="@null"/>
    <TextView android:id="@+id/window_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#d5dee6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
