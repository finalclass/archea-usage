<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_margin="4dp" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="@drawable/card_normal">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/provider_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#f3f6f8" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/provider_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:textColor="#8ed3ff" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/windows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <LinearLayout android:id="@+id/balance_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/balance_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#f3f6f8" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp"/>
            <TextView android:id="@+id/balance_currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8fa1b3" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="pozostało" android:textColor="#8fa1b3" android:textSize="12sp"/>
        <TextView android:id="@+id/spend_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#8fa1b3" android:textSize="12sp" android:visibility="gone"/>
        <TextView android:id="@+id/spend_models" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6e8294" android:textSize="12sp" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/provider_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Brak danych" android:textColor="#8fa1b3" android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/provider_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="end" android:textColor="#6e8294" android:textSize="11sp"/>
</LinearLayout>
